HOST=127.0.0.1
PORT=3000
HOST_BIND=127.0.0.1
PUBLIC_ORIGIN=http://localhost:3000
SHARE_PORT=3001
SHARE_BIND=127.0.0.1
SHARE_HOST=0.0.0.0
DATA_DIR=./data
SECRETS_DIR=./secrets
COOKIE_SECURE=false
# Native HTTPS on the main listener; both files are required. Use COOKIE_SECURE=true.
# TLS_CERT_FILE=/app/secrets/tls.crt
# TLS_KEY_FILE=/app/secrets/tls.key
# Optional exact IP allowlist for remote admin access, comma-separated. Empty = no app-level allowlist.
# ADMIN_ALLOW_IPS=203.0.113.10

# Telegram avatar transport. Values: external, local or auto.
TELEGRAM_TRANSPORT=proxy
TELEGRAM_PROXY_MODE=external
TELEGRAM_PROXY_FILE=./data/telegram-proxies.json
# Run npm run proxies:refresh to populate/update the file.
# Optional manual list, separated by commas (public literal IPs only):
# TELEGRAM_PROXY_URLS=http://PUBLIC_IP:PORT,socks5://PUBLIC_IP:PORT
# Optional local HTTP CONNECT / SOCKS5 adapter:
# TELEGRAM_LOCAL_PROXY_URL=http://127.0.0.1:8080
